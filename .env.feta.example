# Copy to .env.feta and restrict read access to the local operator account.
# DRY_RUN stays true unless an operator explicitly authorizes actual SMTP sending.
FETA_DB_PATH=deep_results/feta.sqlite3
MAIL_PROVIDER=gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
MAIL_USER=your-monitor@gmail.com
MAIL_APP_PASSWORD=replace_with_gmail_app_password
ALERT_EMAIL=ops-team@example.com
TZ_DISPLAY=America/Chicago
QUERY_INTERVAL_HOURS=12
REPLY_TIMEOUT_MINUTES=60
DRY_RUN=true
